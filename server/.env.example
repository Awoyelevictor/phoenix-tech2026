# Server Port
PORT=5001

# MongoDB Connection String
# Replace <username>, <password>, and cluster with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.t8jrqmy.mongodb.net/portfolio?retryWrites=true&w=majority&appName=Cluster0

# Gmail Credentials for Portfolio Contact Form
# GMAIL_APP_PASSWORD must be a 16-character Google App Password (not your Gmail account password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Admin Authentication
# Must be a strong, unique secret password (never use default or trivial passwords like admin123)
ADMIN_PASSWORD=change_this_to_a_strong_random_admin_password

# JWT Signing Secret for secure API sessions
JWT_SECRET=change_this_to_a_random_64_character_hex_or_string_secret

# Allowed CORS Origins (comma-separated for production and development)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000,http://localhost:5001,http://127.0.0.1:5173,http://127.0.0.1:5001,https://your-portfolio-domain.com
